

/* ============================================================
   MAIN WINDOW
   ============================================================ */
QMainWindow {
    background-color: #0A0E14;
    color: #c9d1d9;
}


/* ============================================================
   TOP MENU BAR (File, Edit, View)
   ============================================================ */
#menu {
    background-color: #0D1017;
    color: #B3B1AD;
    border-bottom: 1px solid #21262d;
    font-size: 12px;
}
/* Menu Items. e.g. File,Edit,view etc. */
#menu::item {
    padding: 7px 8px;
    border-radius: 6px;
    margin: 1px 1px;
}
#menu::item:selected {
    background-color: #131721;
    color: #E6E1CF;
}
#menu::item:pressed{
    background-color: #1D2733;
    color: #58a6ff;
}

/* ---- Dropdown menu (New File, Open Folder, etc.) ---- */
/* Menu Items Items. e.g. New file,Open Folder etc. */
QMenu {
    background-color: #0A0E14;
    color: #B3B1AD;
    border: 1px solid #1B222D;
}
QMenu::item {
    padding: 5px 20px 5px 12px;
}
QMenu::item:selected {
    background-color: #273747;
    color: #E6E1CF;
}
QMenu::item:pressed{
    background-color: #2D3F52;
    color: #58a6ff;
}
QMenu::separator {
    background: #1B222D;
    height: 1px;
}


/* ============================================================
   TABS (open files)
   ============================================================ */
QTabWidget::pane {
    border: none;
    background: #0A0E14;
}
QTabBar {
    background: #0A0E14;
    border-bottom: 1px solid #21262d;
}
QTabBar::tab {
    background: #0A0E14;
    color: #8b949e;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 120px;
    font-size: 13px;
}
QTabBar::tab:selected {
    color: #f0f6fc;
    border-bottom: 2px solid #1f6feb;
    background: #0d1117;
}
QTabBar::tab:hover:!selected {
    color: #c9d1d9;
    background: #1c2128;
}


/* ============================================================
   FILE EXPLORER
   ============================================================ */

/* ---- Header bar (folder name + new file/folder buttons) ---- */
#file_explorer_header{
    background-color: #0D1017
}

/* QLabel Style for File Explorer Header */
#folder_name_label {
    color: #B3B1AD;
    font-size: 14px;
    padding: 2px 4px;
}

/* New File / New Folder buttons in the header */
QPushButton#new_file_btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#new_folder_btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#new_file_btn:hover {
    background: #30363d;
}
QPushButton#new_folder_btn:hover {
    background: #30363d;
}
QPushButton#new_file_btn:pressed {
    background: #21262d;
}
QPushButton#new_folder_btn:pressed {
    background: #21262d;
}

/* ---- Tree view (file/folder list) ---- */
#file_tree_view {
    background: #0D1017;
    color: #B3B1AD;
    border: none;
    font-size: 13px;
    outline: none;
}
#file_tree_view::item {
    padding: 5px 4px;
    border-radius: 4px;
    margin: 1px 4px;
}
#file_tree_view::item:hover {
    background-color: #131721;
}
#file_tree_view::item:selected {
    background: #1D2733;
    color: #E6E1CF;
}
#file_tree_view::branch { border-image: none; image: none; }

/* ---- Tree view scrollbars ---- */
#file_tree_view QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    border: none;
}
#file_tree_view QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 30px;
}
#file_tree_view QScrollBar::handle:vertical:hover { background: #484f58; }
#file_tree_view QScrollBar::add-line:vertical, #file_tree_view QScrollBar::sub-line:vertical { height: 0; }
#file_tree_view QScrollBar:horizontal {
    background: #0d1117;
    height: 10px;
    border: none;
}
#file_tree_view QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 30px;
}
#file_tree_view QScrollBar::handle:horizontal:hover { background: #484f58; }
#file_tree_view QScrollBar::add-line:horizontal, #file_tree_view QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Editor frame ---- */
#base_editor {
    border: none;
}

/* ---- Editor scrollbars ---- */
/* Same fix, plus these rules didn't exist before at all - QsciScintilla is a
   QAbstractScrollArea with real QScrollBar children that were never styled. */
#base_editor QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    border: none;
}
#base_editor QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 30px;
}
#base_editor QScrollBar::handle:vertical:hover { background: #484f58; }
#base_editor QScrollBar::add-line:vertical, #base_editor QScrollBar::sub-line:vertical { height: 0; }
#base_editor QScrollBar:horizontal {
    background: #0d1117;
    height: 10px;
    border: none;
}
#base_editor QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 30px;
}
#base_editor QScrollBar::handle:horizontal:hover { background: #484f58; }
#base_editor QScrollBar::add-line:horizontal, #base_editor QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Column headers (used by the tree view) ---- */
QHeaderView::section {
    background: #0A0E14;
    color: #8b949e;
    border: none;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}


/* ============================================================
   SIDE PANEL LABELS (Agent, Git, Output)
   ============================================================ */
QLabel#agent_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}

QLabel#git_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}
QLabel#output_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}


/* ============================================================
   OUTPUT / TERMINAL PANEL
   ============================================================ */
QPlainTextEdit {
    background: #0d1117;
    color: #a1f0a1;
    border: none;
    font-family: 'Cascadia Code', 'Consolas', monospace;
    font-size: 13px;
    selection-background-color: #1f6feb44;
}


/* ============================================================
   STATUS BAR
   ============================================================ */
QStatusBar#status_bar {
    background: #0A0E14;
    color: #8b949e;
    border-top: 1px solid #21262d;
    font-size: 12px;
    padding: 2px 8px;
}
QStatusBar#status_bar::item { border: none; }
QStatusBar#status_bar QLabel {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
}


/* ============================================================
   INPUTS
   ============================================================ */
QLineEdit {
    background: #0A0E14;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #1f6feb55;
}
QLineEdit:focus {
    border-color: #1f6feb;
}


/* ============================================================
   BUTTONS (default, app-wide)
   ============================================================ */
QPushButton {
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #30363d;
    border-color: #8b949e;
}
QPushButton:pressed {
    background: #1f6feb44;
}


/* ============================================================
   LAYOUT / MISC
   ============================================================ */
QSplitter::handle {
    background: #21262d;
    width: 1px;
    height: 1px;
}