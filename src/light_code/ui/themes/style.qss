QMainWindow {
    background-color: #0d1117;
    color: #c9d1d9;
}
QMenuBar {
    background-color: #161b22;
    color: #c9d1d9;
    border-bottom: 1px solid #21262d;
    font-size: 12px;
}
QMenuBar::item {
    padding: 7px 8px;
    border-radius: 6px;
    margin: 1px 1px;
}
QMenuBar::item:selected {
    background-color: #2d3138;
    color: #58a6ff;
}
QMenu {
    background-color: #1c2128;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 7px;
}
QMenu::item {
    padding: 8px 20px 8px 12px;
    border-radius: 4px;
    margin: 3px 3px;
}
QMenu::item:selected {
    background-color: #2d3138;
    color: #58a6ff;
}
QMenu::separator {
    height: 2px;
    background: #21262d;
    margin: 4px 4px;
}
QTabWidget::pane {
    border: none;
    background: #0d1117;
}
QTabBar {
    background: #161b22;
    border-bottom: 1px solid #21262d;
}
QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 120px;
    font-size: 13px;
}
QTabBar::tab:selected {
    color: #f0f6fc;
    border-bottom: 2px solid #1f6feb;
    background: #0d1117;
}
QTabBar::tab:hover:!selected {
    color: #c9d1d9;
    background: #1c2128;
}

/*===================================================*/
/*                 QLabel Styles                     */
/*===================================================*/

/* QLabel Style for File Explorer Header */
QLabel#file_explorer_header {
    color: #8b949e;
    font-size: 14px;
    padding: 2px 4px;
}

QLabel#agent_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}

QLabel#git_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}
QLabel#output_panel_label {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}
/*===================================================*/
/*              QStatusBar Styles                   */
/*===================================================*/

/* QStatusBar Style for Status Bar */
QStatusBar#status_bar {
    background: #161b22;
    color: #8b949e;
    border-top: 1px solid #21262d;
    font-size: 12px;
    padding: 2px 8px;
}
QStatusBar#status_bar::item { border: none; }
QStatusBar#status_bar QLabel {
    color: #8b949e;
    padding: 2px 10px;
    font-size: 12px;
}
QTreeView#file_tree_view {
    background: #0d1117;
    color: #c9d1d9;
    border: none;
    font-size: 13px;
    outline: none;
}
QTreeView#file_tree_view::item {
    padding: 5px 4px;
    border-radius: 4px;
    margin: 1px 4px;
}
QTreeView#file_tree_view::item:selected {
    background: #28414C;
    color: #58a6ff;
}
QTreeView#file_tree_view::item:hover:!selected {
    background: #1c2128;
}
QTreeView#file_tree_view::branch { border-image: none; image: none; }
QHeaderView::section {
    background: #161b22;
    color: #8b949e;
    border: none;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QSplitter::handle {
    background: #21262d;
    width: 1px;
    height: 1px;
}
QLineEdit {
    background: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #1f6feb55;
}
QLineEdit:focus {
    border-color: #1f6feb;
}

/*===================================================*/
/*              QPushButton Styles                   */
/*===================================================*/

/* QPushButton Styles for the file explorer header */
QPushButton#new_file_btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#new_folder_btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}
QPushButton#new_file_btn:hover {
    background: #30363d;
}
QPushButton#new_folder_btn:hover {
    background: #30363d;
}
QPushButton#new_file_btn:pressed {
    background: #21262d;
}
QPushButton#new_folder_btn:pressed {
    background: #21262d;
}

/* QPushButton Default Styles */
QPushButton {
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #30363d;
    border-color: #8b949e;
}
QPushButton:pressed {
    background: #1f6feb44;
}

QPlainTextEdit {
    background: #0d1117;
    color: #a1f0a1;
    border: none;
    font-family: 'Cascadia Code', 'Consolas', monospace;
    font-size: 13px;
    selection-background-color: #1f6feb44;
}
QScrollBar#file_tree_view:vertical {
    background: #0d1117;
    width: 10px;
    border: none;
}
QScrollBar#file_tree_view::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar#file_tree_view::handle:vertical:hover { background: #484f58; }
QScrollBar#file_tree_view::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar#file_tree_view:horizontal {
    background: #0d1117;
    height: 10px;
    border: none;
}
QScrollBar#file_tree_view::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar#file_tree_view::handle:horizontal:hover { background: #484f58; }
QScrollBar#file_tree_view::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
